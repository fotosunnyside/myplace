# Copy to .env.local for local development. Every value here is PUBLIC (it ships to the browser).
# Never put the Supabase service_role key or a media provider's API secret in a NEXT_PUBLIC_* variable.

# PLACES backend (Supabase): Project Settings → API. Leave empty for the on-device preview.
# The anon key is called the publishable key (sb_publishable_…) on newer projects; either variable name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live video provider adapter name (lib/spaces/media). Empty = on-device camera/mic only.
NEXT_PUBLIC_MEDIA_PROVIDER=
